@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');

:root{font-family:Manrope,Arial,sans-serif;color:#edf0fc;background:#0a0e1c;font-synthesis:none}*{box-sizing:border-box}body{margin:0;min-width:320px;background:#0a0e1c}button,input,select,textarea{font:inherit}button{cursor:pointer;border:0}a{text-decoration:none;color:inherit}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid #a894ff;outline-offset:2px}.brand{display:flex;align-items:center;gap:9px;font-size:20px;font-weight:800;letter-spacing:-1px;color:#f7f7ff}.brand>span:last-child{color:#a997ff}.brand-mark{height:22px;width:21px;display:flex;align-items:flex-end;gap:3px}.brand-mark i{width:5px;border-radius:3px;background:linear-gradient(#c7c0ff,#7865dc)}.brand-mark i:nth-child(1){height:10px}.brand-mark i:nth-child(2){height:16px}.brand-mark i:nth-child(3){height:22px}.button{border-radius:9px;padding:11px 15px;font-size:12px;font-weight:800;transition:.18s}.button:hover{transform:translateY(-1px)}.button-primary{background:#a18cf8;color:#110e24;box-shadow:0 8px 20px #715be540}.button-primary:hover{background:#b3a1ff}.button-secondary{border:1px solid #333b55;background:#1b2031;color:#dbe0f1}.button-ghost{background:transparent;color:#a6aec5}.button-ghost:hover{background:#ffffff0c}.eyebrow{display:flex;align-items:center;gap:8px;text-transform:uppercase;letter-spacing:1.7px;font-weight:800;font-size:10px;color:#ab9cff}.eyebrow span{width:7px;height:7px;border-radius:50%;background:#a893ff;box-shadow:0 0 15px #977fff}.text-link{color:#bfc6dc;margin-right:16px;font-size:12px;font-weight:700}.compact{padding:9px 13px}
/* Home */.landing{min-height:100vh;overflow:hidden;position:relative;background:radial-gradient(circle at 50% 31%,#262151 0,#11162a 32%,#090d1a 72%)}.topbar{position:relative;z-index:1;height:76px;border-bottom:1px solid #ffffff0b;padding:0 clamp(22px,6vw,90px);display:flex;align-items:center;justify-content:space-between}.hero{position:relative;z-index:1;max-width:700px;padding:140px 24px 100px;margin:auto;text-align:center}.hero .eyebrow{justify-content:center}.hero h1{font-size:clamp(72px,11vw,130px);line-height:.9;letter-spacing:-8px;margin:20px 0 30px}.hero h1 span{color:#aa97ff}.start-button{font-size:14px;padding:15px 22px;margin-bottom:34px}.start-button span{margin-left:15px}.hero>p{max-width:610px;margin:0 auto;color:#adb5cd;font-size:14px;line-height:1.8}.hero .hero-note{color:#838da7;font-size:11px;margin-top:15px}.orbit{position:absolute;border-radius:50%;border:1px solid #a899ff13;left:50%;transform:translateX(-50%);pointer-events:none}.orbit-a{top:65px;width:780px;height:780px}.orbit-b{top:-115px;width:1120px;height:1120px}
/* auth */.auth-page{min-height:100vh;display:grid;place-items:center;background:radial-gradient(circle at 50% 30%,#292451,#0a0e1d 61%);padding:28px}.back-link{position:absolute;top:26px;left:30px;color:#aeb6cc;font-size:11px;font-weight:700}.auth-card{width:min(100%,440px);padding:34px;border-radius:16px;background:#161b2c;border:1px solid #343c57;box-shadow:0 25px 65px #00000076}.auth-card>.brand{justify-content:center}.auth-heading{text-align:center;margin:29px 0 24px}.auth-heading .eyebrow{justify-content:center}.auth-heading h1{font-size:27px;letter-spacing:-1.5px;margin:11px 0 7px}.auth-heading p{margin:0;color:#a4acc4;font-size:11px;line-height:1.65}.auth-card form{display:grid;gap:14px}.auth-card label{display:grid;gap:7px;color:#c6cde0;font-size:10px;font-weight:700}.auth-card input{border:1px solid #303850;background:#0f1321;color:white;border-radius:7px;padding:11px;font-size:12px}.auth-card form .button{margin-top:5px}.auth-switch{text-align:center;color:#959eb7;font-size:10px;margin:20px 0 0}.auth-switch button{background:transparent;color:#b09fff;font-size:inherit;font-weight:800;padding:0}
/* application layout */.app-shell{min-height:100vh;display:flex;background:#0d1120}.sidebar{width:238px;min-height:100vh;padding:28px 14px 17px;flex-shrink:0;display:flex;flex-direction:column;background:#101525;border-right:1px solid #252d44}.sidebar>.brand{margin:0 13px 29px}.workspace-label{display:flex;align-items:center;gap:10px;padding:9px 11px;border:1px solid #2f3851;border-radius:8px;background:#1a2032}.workspace-label>span,.account>span{display:grid;place-items:center;width:28px;height:28px;border-radius:7px;background:#7663d9;font-weight:800;font-size:11px}.workspace-label b,.workspace-label small,.account b,.account small{display:block}.workspace-label b,.account b{font-size:10px}.workspace-label small,.account small{font-size:8px;color:#929bb4;margin-top:2px}.sidebar nav{display:grid;gap:3px;margin-top:25px}.sidebar nav a{padding:11px 12px;display:flex;align-items:center;gap:12px;border-radius:8px;color:#969fb9;font-size:12px;font-weight:700}.sidebar nav a span{width:17px;text-align:center;font-size:16px}.sidebar nav a.active,.sidebar nav a:hover{background:#282342;color:#c3b7ff}.sidebar-bottom{margin-top:auto}.sidebar-bottom>.button{font-size:10px}.account{padding:15px 6px 0;border-top:1px solid #293149;display:flex;gap:9px;align-items:center}.account>span{border-radius:50%;background:#3b6387}.app-content{padding:42px clamp(23px,5vw,72px);width:100%;max-width:1450px}.page-header{display:flex;align-items:end;justify-content:space-between;gap:25px;margin-bottom:33px}.page-header h1{font-size:27px;letter-spacing:-1.6px;margin:7px 0 0}.page-header p{color:#939cb5;font-size:11px;margin:7px 0 0}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.metric,.dashboard-card,.history-card,.profile-card,.preferences,.project-card{border:1px solid #2a324a;border-radius:11px;background:#161b2c}.metric{padding:20px}.metric b,.metric strong,.metric small{display:block}.metric b{font-size:24px;letter-spacing:-1px}.metric strong{font-size:11px;margin-top:3px}.metric small{font-size:9px;color:#8993ad;margin-top:5px}.dashboard-card,.history-card{margin-top:17px}.dashboard-card>header{display:flex;justify-content:space-between;padding:20px 21px 13px}.dashboard-card h2,.preferences h2{font-size:14px;margin:0}.dashboard-card p{font-size:10px;color:#8992aa;margin:5px 0}.dashboard-card a{font-size:10px;color:#ae9fff;font-weight:800}.analysis-row{display:flex;align-items:center;gap:11px;padding:14px 20px;border-top:1px solid #2a324a}.analysis-row>span{display:grid;place-items:center;width:29px;height:29px;border-radius:7px;background:#27314c;color:#ad9cff}.analysis-row>div{flex:1}.analysis-row b,.analysis-row small{display:block}.analysis-row b{font-size:11px}.analysis-row small{font-size:9px;color:#9099b1;margin-top:4px}.analysis-row em{font-style:normal;font-size:9px;font-weight:800;color:#74d4b7;background:#183b37;padding:5px 7px;border-radius:20px}.analysis-row em.review{color:#e9c877;background:#453a20}.analysis-row time{font-size:9px;color:#8992aa}.project-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.project-card{padding:21px}.project-card>span{display:grid;place-items:center;width:36px;height:36px;border-radius:8px;background:#3c6186;font-size:14px;font-weight:800;margin-bottom:19px}.project-card small{font-size:9px;color:#8a93ac}.project-card h2{font-size:14px;margin:6px 0}.project-card p{font-size:10px;line-height:1.6;color:#969fb8}.project-card footer{display:flex;justify-content:space-between;border-top:1px solid #2b334a;padding-top:13px;margin-top:18px;font-size:9px;color:#8790a8}.project-card a{font-size:10px;color:#ab9afa;font-weight:800}.profile-card{padding:22px;display:flex;align-items:center;gap:14px;max-width:700px}.profile-card>span{display:grid;place-items:center;width:52px;height:52px;border-radius:50%;background:#3a6388;font-size:15px;font-weight:800}.profile-card h2{font-size:16px;margin:0}.profile-card p{font-size:11px;color:#929cb5;margin:4px 0}.profile-card .button{margin-left:auto}.preferences{max-width:700px;padding:22px;margin-top:15px}.preferences label{display:flex;justify-content:space-between;align-items:center;border-top:1px solid #2a324a;padding:15px 0}.preferences label:first-of-type{margin-top:10px}.preferences label b,.preferences label small{display:block}.preferences label b{font-size:11px}.preferences label small{font-size:9px;color:#919bb4;margin-top:4px}.preferences input{accent-color:#a18cf8}.preferences select{background:#101525;color:#e3e7f6;border:1px solid #343c54;border-radius:6px;padding:7px;font-size:10px}
/* analysis workflow */.workflow-page,.results-page{min-height:100vh;background:#0c1020}.workflow-nav{height:66px;padding:0 clamp(20px,5vw,74px);display:flex;align-items:center;gap:26px;border-bottom:1px solid #242c43;background:#101525}.workflow-nav>span{font-size:11px;color:#aab2c8;font-weight:700}.workflow-nav .button{margin-left:auto}.workflow-content,.results-content{max-width:1090px;margin:auto;padding:56px 24px}.workflow-content .page-header{margin-bottom:29px}.setup-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.setup-card{position:relative;padding:22px;background:#161b2c;border:1px solid #2d354d;border-radius:12px}.settings-card{grid-column:span 2}.step-label{position:absolute;top:17px;right:19px;color:#49526b;font:13px 'DM Mono'}.setup-card h2{font-size:14px;margin:0}.setup-card>p{font-size:10px;color:#929bb3;margin:5px 0 17px}.tabs{display:flex;gap:15px;border-bottom:1px solid #2b334b;margin-bottom:15px}.tabs button{padding:0 0 9px;color:#8f98b1;background:transparent;font-size:10px}.tabs button.active{color:#b8a8ff;border-bottom:2px solid #a18cf8}.dropzone{min-height:156px;display:flex;flex-direction:column;justify-content:center;align-items:center;border:1px dashed #59637e;border-radius:9px;background:#111625;text-align:center}.dropzone input{position:absolute;opacity:0;pointer-events:none}.dropzone>span{font-size:21px;color:#ad9cf9;margin-bottom:5px}.dropzone b{font-size:10px}.dropzone small{font-size:9px;color:#8992aa;margin-top:5px}.dropzone em{font-size:9px;color:#ad9cf9;font-style:normal;font-weight:800;margin-top:10px}.setup-card textarea{display:block;width:100%;resize:vertical;border-radius:9px;border:1px solid #303951;background:#111625;color:#edf0fc;padding:11px;font-size:11px;line-height:1.6}.settings-summary{display:flex;width:100%;align-items:center;justify-content:space-between;padding:12px;border-radius:8px;border:1px solid #2b334a;background:#111625;color:#e7eaf8;text-align:left}.settings-summary b,.settings-summary small{display:block}.settings-summary b{font-size:10px}.settings-summary small{font-size:9px;color:#8993ab;margin-top:4px}.settings-summary i{font-style:normal;color:#ac9af7}.settings-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:13px}.settings-grid label{display:grid;gap:6px;color:#aab2c8;font-size:9px}.settings-grid select,.settings-grid input{background:#0e1321;color:#e0e5f3;border:1px solid #343c54;border-radius:6px;padding:8px;font-size:10px}.workflow-footer{display:flex;align-items:center;justify-content:space-between;padding-top:24px}.workflow-footer p{font-size:10px;color:#8992ab}.workflow-footer .button{padding:12px 17px}
/* results */.results-content{max-width:1250px;padding-top:38px}.results-header{display:flex;justify-content:space-between;align-items:end;gap:22px;margin-bottom:24px}.results-header h1{font-size:29px;letter-spacing:-1.6px;margin:9px 0 6px}.results-header p{font-size:11px;color:#939cb4;margin:0}.results-header>div:last-child{display:flex;gap:9px}.result-stats{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid #2a324a;border-radius:10px;background:#161b2c}.result-stats div{padding:17px 20px;border-right:1px solid #2a324a}.result-stats div:last-child{border:0}.result-stats b,.result-stats span{display:block}.result-stats b{font-size:19px}.result-stats span{color:#919bb4;font-size:9px;margin-top:3px}.results-workbench{display:grid;grid-template-columns:300px 1fr;gap:15px;margin-top:18px}.requirement-panel,.trace-detail{overflow:hidden;border:1px solid #2a324a;border-radius:10px;background:#161b2c}.requirement-panel header{display:flex;justify-content:space-between;padding:14px;border-bottom:1px solid #2a324a}.requirement-panel header b{font-size:11px}.requirement-panel header span{font-size:9px;color:#9099b1}.requirement{display:block;width:100%;padding:13px;text-align:left;color:#e4e7f4;background:transparent;border-bottom:1px solid #283048}.requirement:hover,.requirement.active{background:#292443}.requirement small,.requirement b,.requirement span{display:block}.requirement small{font:9px 'DM Mono';color:#b19fff;margin-bottom:4px}.requirement b{font-size:10px;line-height:1.45}.requirement span{font-size:8px;color:#8993aa;margin-top:6px}.trace-detail>header{display:flex;justify-content:space-between;gap:20px;padding:20px;border-bottom:1px solid #2a324a}.trace-detail header small{font:10px 'DM Mono';color:#ae9cfc}.trace-detail h2{font-size:15px;margin:6px 0}.confidence{height:max-content;padding:5px 8px;border-radius:15px;font-size:9px;font-weight:800;white-space:nowrap}.confidence.high{background:#183b37;color:#74d4b7}.confidence.medium{background:#453a20;color:#e9c877}.implementation{margin:19px;padding:16px;border:1px solid #35415f;border-radius:9px;background:#121827}.implementation>div{display:flex;align-items:center;gap:10px}.implementation>div>span{display:grid;place-items:center;width:31px;height:31px;border-radius:7px;background:#2b3552;color:#ad9bfa}.implementation section{flex:1}.implementation small{font-size:8px;color:#8f99b1}.implementation h3{font:11px 'DM Mono';margin:3px 0}.implementation b{font-size:12px;color:#79d7ba}.implementation p{font-size:10px;line-height:1.7;color:#a9b1c7;margin:14px 0}.implementation .button{padding:0;font-size:10px;color:#af9eff}.connection{height:170px;margin:0 19px 19px;display:flex;align-items:center;justify-content:center;background:radial-gradient(#30384d55 1px,transparent 1px);background-size:13px 13px}.connection>div{z-index:1;min-width:150px;padding:11px;border:1px solid #7566b9;border-radius:8px;background:#172036;color:#d6d1ff;font:10px 'DM Mono'}.connection>div small{display:block;font:7px Manrope;color:#8b80b9;margin-bottom:5px}.connection>div.code{border-color:#397c70;color:#b9efd9}.connection>div.code small{color:#73b4a6}.connection i{margin:0 -2px;color:#65b89f;font-style:normal;font-size:22px}
@media(max-width:800px){.sidebar{display:none}.app-content{padding:29px 18px}.metrics,.project-grid,.setup-grid{grid-template-columns:1fr}.page-header,.results-header,.workflow-footer{align-items:flex-start;flex-direction:column}.settings-card{grid-column:span 1}.settings-grid{grid-template-columns:1fr 1fr}.results-workbench{grid-template-columns:1fr}.requirement-panel{max-height:255px}.result-stats{grid-template-columns:1fr 1fr}.result-stats div:nth-child(2){border-right:0}.results-header>div:last-child{width:100%}.results-header>div:last-child .button{flex:1}.hero{padding-top:115px}.hero h1{letter-spacing:-5px}.workflow-nav{gap:13px}.workflow-nav>span{display:none}.analysis-row time{display:none}.orbit-a{width:650px;height:650px}.orbit-b{width:900px;height:900px}.profile-card .button{display:none}}
